{
  "extends": "../../geonature/frontend/tsconfig.json",
  "exclude": [
    "node_modules",
    "dist"
  ],
  "compilerOptions": {
    "baseUrl": "./",
    "typeRoots": [
      "../../geonature/frontend/node_modules/@types"
    ],
    "paths": {
      "@geonature/*": ["../../geonature/frontend/src/app/*"],
      "@geonature_common/*": ["../../geonature/frontend/src/app/GN2CommonModule/*"],
      "@angular/*": ["../../geonature/frontend/node_modules/@angular/*"],
      "@ng-bootstrap/*": ["../../geonature/frontend/node_modules/@ng-bootstrap/*"],
      "rxjs": ["../../geonature/frontend/node_modules/rxjs"],
      "rxjs/*": ["../../geonature/frontend/node_modules/rxjs/*"],
      "tslib": ["../../geonature/frontend/node_modules/tslib"]
    },
    "skipLibCheck": true,
  }
}

